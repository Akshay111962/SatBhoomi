# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and test artifacts
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Database files (SQLite)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Data directories (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
