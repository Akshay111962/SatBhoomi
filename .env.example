# SatBhoomi Score + Raksha - Environment Configuration Template
# Copy this file to .env and customize for local development. Never commit real secrets.

APP_NAME="SatBhoomi Score + Raksha"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Security (Placeholder for development only - generate strong secret for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (SQLite for PoC; set postgresql+psycopg2://user:pass@host:port/dbname for PostgreSQL)
DATABASE_URL=sqlite:///./data/satbhoomi.db
